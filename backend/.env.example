# Copy this file to backend/.env and fill in real values

# PostgreSQL (Neon) connection string — or sqlite:///./data/realcheck.db for local dev
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret (any long random string)
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gmail account used to send password-reset codes (use a 16-char Google App Password)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
RESET_CODE_EXPIRE_MINUTES=10
